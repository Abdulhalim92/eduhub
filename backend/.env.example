# Скопируйте в .env и при необходимости поправьте. Секреты в репозиторий не коммитим.
PORT=8080
DATABASE_URL=postgres://eduhub:eduhub@127.0.0.1:5433/eduhub?sslmode=disable
JWT_SECRET=dev-insecure-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
BCRYPT_COST=12

# Учётка суперадмина для сидера (cmd/seed). Только для разработки.
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=admin12345
