# Источник данных фронтенда. Скопируйте в .env.local и поправьте (.env.local в git не попадает).
#   mock — демо без сервера: mock прототипа в памяти страницы (по умолчанию; так же работают тесты и e2e)
#   http — сервер «Линия» (backend/ ветки dev): запросы /api/* Vite проксирует на API_PROXY_TARGET
VITE_API_MODE=http
# Адрес api для браузера; по умолчанию /api (через прокси Vite). На проде — адрес сервера, например https://api.example.tj
# VITE_API_URL=/api
# Куда прокси Vite отправляет /api/* в разработке (по умолчанию http://127.0.0.1:8080)
# API_PROXY_TARGET=http://127.0.0.1:8080
