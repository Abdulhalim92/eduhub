{
  // Playwright: код теста выполняется в Node, а колбэки page.evaluate — в браузере, поэтому нужны и node, и DOM.
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": ["ES2023", "DOM"]
  },
  "include": ["playwright.config.ts", "e2e"]
}
